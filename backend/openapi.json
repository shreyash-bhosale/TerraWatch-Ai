{
  "openapi": "3.1.0",
  "info": {
    "title": "TerraWatch AI API",
    "description": "Provider-agnostic surface change detection API for SAR imagery",
    "version": "0.1.0"
  },
  "paths": {
    "/api/observations/search": {
      "post": {
        "tags": [
          "observations"
        ],
        "summary": "Search Observations",
        "operationId": "search_observations_api_observations_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservationSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid geometry or search query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Provider not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/observations": {
      "get": {
        "tags": [
          "observations"
        ],
        "summary": "List Observations",
        "operationId": "list_observations_api_observations_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationListResponse"
                }
              }
            }
          },
          "502": {
            "description": "Provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Provider not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/observations/{id}": {
      "get": {
        "tags": [
          "observations"
        ],
        "summary": "Get Observation",
        "operationId": "get_observation_api_observations__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observation"
                }
              }
            }
          },
          "403": {
            "description": "Path traversal or forbidden ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Observation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Provider not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analysis/validate": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Validate Analysis Pair",
        "operationId": "validate_analysis_pair_api_analysis_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Observation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Incompatible observations or invalid AOI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/analysis": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Create Analysis Job",
        "operationId": "create_analysis_job_api_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Observation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed or incompatible pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/analysis/{job_id}": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Get Analysis Status",
        "operationId": "get_analysis_status_api_analysis__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analysis/{job_id}/results": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Get Analysis Results",
        "operationId": "get_analysis_results_api_analysis__job_id__results_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResultsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Result not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Job not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "GeoJSONPolygonGeometry": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Polygon",
            "title": "Type",
            "default": "Polygon"
          },
          "coordinates": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Coordinates",
            "description": "Array of linear rings in [longitude, latitude] coordinates. Outer ring first, closed."
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "GeoJSONPolygonGeometry"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthChecks": {
        "properties": {
          "data_dir": {
            "type": "boolean",
            "title": "Data Dir"
          },
          "fixtures": {
            "type": "boolean",
            "title": "Fixtures"
          }
        },
        "type": "object",
        "required": [
          "data_dir",
          "fixtures"
        ],
        "title": "HealthChecks"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "synthetic_mode": {
            "type": "boolean",
            "title": "Synthetic Mode"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "provider",
          "synthetic_mode",
          "checks"
        ],
        "title": "HealthResponse"
      },
      "JobCreateRequest": {
        "properties": {
          "before_id": {
            "type": "string",
            "title": "Before Id"
          },
          "after_id": {
            "type": "string",
            "title": "After Id"
          },
          "aoi": {
            "$ref": "#/components/schemas/GeoJSONPolygonGeometry"
          }
        },
        "type": "object",
        "required": [
          "before_id",
          "after_id",
          "aoi"
        ],
        "title": "JobCreateRequest"
      },
      "JobCreateResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobCreateResponse"
      },
      "JobError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "JobError"
      },
      "JobResultsResponse": {
        "properties": {
          "statistics": {
            "$ref": "#/components/schemas/Stats"
          },
          "bounds": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bounds",
            "description": "[west, south, east, north] in EPSG:4326"
          },
          "layers": {
            "$ref": "#/components/schemas/LayerUrls"
          },
          "geotiff_url": {
            "type": "string",
            "title": "Geotiff Url"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          }
        },
        "type": "object",
        "required": [
          "statistics",
          "bounds",
          "layers",
          "geotiff_url",
          "metadata",
          "limitations",
          "synthetic"
        ],
        "title": "JobResultsResponse"
      },
      "JobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "validating",
              "reading",
              "aligning",
              "differencing",
              "statistics",
              "exporting",
              "completed",
              "failed"
            ],
            "title": "Stage"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "before_id": {
            "type": "string",
            "title": "Before Id"
          },
          "after_id": {
            "type": "string",
            "title": "After Id"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "stage",
          "created_at",
          "before_id",
          "after_id",
          "synthetic"
        ],
        "title": "JobStatusResponse"
      },
      "LayerUrls": {
        "properties": {
          "difference_png": {
            "type": "string",
            "title": "Difference Png"
          },
          "before_png": {
            "type": "string",
            "title": "Before Png"
          },
          "after_png": {
            "type": "string",
            "title": "After Png"
          }
        },
        "type": "object",
        "required": [
          "difference_png",
          "before_png",
          "after_png"
        ],
        "title": "LayerUrls"
      },
      "Observation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "description": "Whether this observation is synthetic demo data"
          },
          "acquisition_date": {
            "type": "string",
            "title": "Acquisition Date",
            "description": "ISO 8601 acquisition timestamp"
          },
          "geometry": {
            "$ref": "#/components/schemas/GeoJSONPolygonGeometry"
          },
          "asset_location": {
            "type": "string",
            "title": "Asset Location"
          },
          "asset_format": {
            "type": "string",
            "title": "Asset Format"
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Name"
          },
          "polarization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Polarization"
          },
          "frequency_band": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frequency Band"
          },
          "orbit_direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Orbit Direction"
          },
          "processing_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Level"
          },
          "measurement_units": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurement Units"
          },
          "resolution": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          },
          "crs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crs"
          },
          "source_metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Metadata"
          }
        },
        "type": "object",
        "required": [
          "id",
          "provider",
          "synthetic",
          "acquisition_date",
          "geometry",
          "asset_location",
          "asset_format"
        ],
        "title": "Observation"
      },
      "ObservationListResponse": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Observations"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "observations",
          "total"
        ],
        "title": "ObservationListResponse"
      },
      "ObservationOrder": {
        "properties": {
          "before_id": {
            "type": "string",
            "title": "Before Id"
          },
          "after_id": {
            "type": "string",
            "title": "After Id"
          }
        },
        "type": "object",
        "required": [
          "before_id",
          "after_id"
        ],
        "title": "ObservationOrder"
      },
      "ObservationSearchRequest": {
        "properties": {
          "aoi": {
            "$ref": "#/components/schemas/GeoJSONPolygonGeometry"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          }
        },
        "type": "object",
        "required": [
          "aoi"
        ],
        "title": "ObservationSearchRequest"
      },
      "ObservationSearchResponse": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Observations"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "observations"
        ],
        "title": "ObservationSearchResponse"
      },
      "RuleResult": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ],
            "title": "Severity"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "id",
          "severity",
          "passed",
          "message"
        ],
        "title": "RuleResult"
      },
